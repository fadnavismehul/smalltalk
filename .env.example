# Gemini API Key (Required for server-side structured extraction)
# Works with an AI Studio key, or a Vertex AI express-mode key (set USE_VERTEX_AI=true)
GEMINI_API_KEY=
# Set to 'true' if GEMINI_API_KEY is a Vertex AI express-mode key
USE_VERTEX_AI=

# Alternative provider: route all AI calls through OpenRouter (takes priority over GEMINI_API_KEY)
OPENROUTER_API_KEY=
# Model slug on OpenRouter (default: google/gemini-3.7-flash)
OPENROUTER_MODEL=
